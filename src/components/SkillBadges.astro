---
/**
 * Lista de badges de tecnologias.
 * Fonte única dos dados: src/data/skills.ts
 */
import type { SkillBadge } from "../data/skills";
import { badgeSlug, renderBadge } from "../lib/badges";

interface Props {
  badges: SkillBadge[];
  loading?: "eager" | "lazy";
  eagerCount?: number;
}

const { badges, loading = "lazy", eagerCount = 0 } = Astro.props;

const items = badges.map((badge, index) => ({
  alt: badge.alt,
  src: `/badges/${badgeSlug(badge.alt)}.svg`,
  width: renderBadge(badge).width,
  loading: index < eagerCount ? ("eager" as const) : loading,
}));
---

<div class="skill-badges">
  {items.map((badge) => (
    <img
      src={badge.src}
      alt={badge.alt}
      title={badge.alt}
      width={badge.width}
      height="28"
      loading={badge.loading}
      decoding="async"
    />
  ))}
</div>
