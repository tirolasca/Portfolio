---
import { Image, Picture } from "astro:assets";
import perfil from "../assets/img/perfil.webp";
import logo from "../assets/img/logo.webp";
import { projects } from "../data/projects";
import { skillCategories } from "../data/skills";

// Contagens derivadas dos dados: basta editar src/data/*.ts
const projectCount = projects.length;
const technologyCount = new Set(
  skillCategories.flatMap((category) => category.badges.map((b) => b.alt)),
).size;
---

<section class="hero" id="home">
  <canvas id="networkCanvas"></canvas>
  <div class="container hero-inner">
    <div class="hero-content">
      <h2>
        👋 Olá, eu sou
        <span class="scramble-text" data-value="Lucas Santos">
          Lucas Santos
        </span>
      </h2>
      <h3 class="hero-subtitle">
        <Image
          src={logo}
          alt="Logo"
          class="hero-logo"
          width={50}
          densities={[1, 2]}
        />
        <span id="typewriter"></span>
      </h3>
      <p class="lead">
        Sou formado em <strong>Desenvolvimento de Sistemas</strong> e
        <strong>Redes de Computadores</strong>, e atualmente curso
        <strong>Desenvolvimento de Software Multiplataforma</strong> na FATEC.
        Tenho paixão por tecnologia e busco unir
        <strong>inovação</strong>, <strong>desempenho</strong> e
        <strong>impacto real</strong> em cada projeto.
      </p>
      <div class="hero-cta">
        <a href="/curriculo.html" class="btn primary">
          <i class="fa-solid fa-user" aria-hidden="true"></i> Ver Currículo
          Completo
        </a>
        <a
          href="/Lucas Santos - Currículo.pdf"
          download="Lucas Santos - Currículo.pdf"
          class="btn outline"
        >
          <i class="fa-solid fa-file-arrow-down" aria-hidden="true"></i> Baixar
          Currículo
        </a>
      </div>
      <div class="social-icons">
        <a
          href="https://wa.me/5512981718913"
          target="_blank"
          rel="noopener noreferrer"
          class="social-btn"
          title="WhatsApp"
        >
          <i class="fab fa-whatsapp fa-2x" aria-hidden="true"></i>
        </a>
        <a
          href="https://github.com/tirolasca"
          target="_blank"
          rel="noopener noreferrer"
          class="social-btn github"
          title="GitHub"
        >
          <i class="fab fa-github fa-2x" aria-hidden="true"></i>
        </a>
        <a
          href="https://linkedin.com/in/lucas-santostec/"
          target="_blank"
          rel="noopener noreferrer"
          class="social-btn"
          title="LinkedIn"
        >
          <i class="fab fa-linkedin fa-2x" aria-hidden="true"></i>
        </a>
        <a
          href="mailto:lucasnascimento1245@gmail.com"
          class="social-btn"
          title="E-mail"
        >
          <i class="fa-solid fa-envelope fa-2x" aria-hidden="true"></i>
        </a>
        <button type="button" id="summary-mode-btn" class="btn outline">
          <i class="fa-solid fa-bolt" aria-hidden="true"></i> Resumo de 30s
        </button>
      </div>

      <a
        href="https://github.com/tirolasca"
        class="gh-activity-pill"
        id="gh-activity-pill"
      >
        <span class="gh-activity-dot"></span>
        <span id="gh-activity-text">Verificando atividade no GitHub...</span>
      </a>

      <div class="hero-stats">
        <div class="hero-stat">
          <span class="hero-stat-number" data-count={projectCount}>
            0
          </span>
          <span class="hero-stat-label">Projetos</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-number" data-count={technologyCount}>
            0
          </span>
          <span class="hero-stat-label">Tecnologias</span>
        </div>
      </div>
    </div>

    <div class="hero-container" data-reveal="fade-left">
      <div class="hero-image">
        <Picture
          src={perfil}
          alt="Lucas Santos"
          class="hero-avatar"
          widths={[240, 480]}
          sizes="240px"
          formats={["avif"]}
          fallbackFormat="webp"
          quality={75}
          priority
        />
      </div>
      <div class="hero-text">📱 Escaneie o QR Code!</div>
    </div>
  </div>
</section>
