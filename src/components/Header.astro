---
import { Image } from "astro:assets";
import logo from "../assets/img/logo.png";
interface Props {
  /** página do currículo: id="top" e ícone/label de tema próprios */
  isResume?: boolean;
}
const { isResume = false } = Astro.props;
---

<header id={isResume ? "top" : undefined} class="site-header">
  <div class="container header-inner">
    <div class="brand">
      <a href="/">
        <Image
          src={logo}
          alt="Logo Lucas Santos"
          class="logo-header"
          width={65}
          densities={[1, 2]}
          priority
        />
      </a>
      <div class="brand-text">
        <h1>Lucas Santos</h1>
        <p class="job">Desenvolvedor de Software</p>
      </div>
    </div>

    <nav class="main-nav" aria-label="Menu principal">
      <ul>
        <li>
          <a href="/">Início</a>
        </li>
        <li>
          <a href="/curriculo.html">Currículo</a>
        </li>
        <li>
          <a href="#contato">Contato</a>
        </li>
      </ul>
    </nav>

    <div class="header-actions">
      <button
        id="achievements-toggle"
        class="achievements-btn"
        aria-label="Ver conquistas, 0 desbloqueadas"
        title="Conquistas"
      >
        <i class="fa-solid fa-trophy" aria-hidden="true"></i>
        <span class="achievements-badge" id="achievements-badge">
          0
        </span>
      </button>

      <button
        id="terminal-btn"
        class="achievements-btn terminal-trigger-btn"
        aria-label="Abrir terminal"
        title="Terminal"
      >
        <i class="fa-solid fa-terminal" aria-hidden="true"></i>
      </button>

      <button
        id="theme-toggle"
        class="theme-toggle"
        aria-label={isResume ? "Alterar tema" : "Alternar tema"}
      >
        {isResume ? (
          <i class="fa-solid fa-sun" aria-hidden="true" />
        ) : (
          <i class="fa-solid fa-moon" id="theme-icon" aria-hidden="true" />
        )}
      </button>

      <!-- Seletor de idioma (GTranslate): o JS o preenche quando o navegador está ocioso -->
      <div class="gtranslate_wrapper notranslate" translate="no"></div>
    </div>
  </div>
</header>
