---
import { Image } from "astro:assets";
import logoNome from "../assets/img/logo-nome.webp";
interface Props {
  topHref: string;
}
const { topHref } = Astro.props;
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="/">
        <Image
          src={logoNome}
          alt="Logo Lucas Santos"
          class="footer-logo"
          width={130}
          densities={[1, 2]}
          loading="lazy"
        />
      </a>
      <p>| Todos os direitos reservados.</p>
    </div>
  </div>
</footer>

<a class="back-to-top" href={topHref} aria-label="Voltar ao topo"></a>
