# Opcional — Core Web Vitals reais (dados de campo)
# Endpoint que recebe POST (sendBeacon) com { name, value, rating, id, path }
PUBLIC_VITALS_URL=

# Opcional — envio real do formulário de contato pelo Formspree.
# Use o endpoint do seu formulário: https://formspree.io/f/<id>
# Sem isso, o formulário abre o app de e-mail (mailto:).
PUBLIC_CONTACT_ENDPOINT=
